DATABASE_URL=postgres://rolemodel:rolemodel@localhost:5433/role_model?sslmode=disable
ANTHROPIC_API_KEY=<My Key>
PORT=8080
ENVIRONMENT=development
SEED_DIR="./database/seed"
# Signs JWTs. Has no default: leaving it unset silently signs tokens with an
# empty key. Set it to a long random string, e.g. `openssl rand -base64 32`.
JWT_SECRET=<generate a random secret>
CORS_ALLOWED_ORIGINS=http://localhost:5173
RENDERER_URL=http://localhost:8000
