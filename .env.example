DATABASE_URL=postgres://rolemodel:rolemodel@localhost:5433/role_model?sslmode=disable
# You supply your own key and pay for your own tokens; this service never
# ships one. Required: the server refuses to start without it.
ANTHROPIC_API_KEY=sk-ant-...
PORT=8080
ENVIRONMENT=development
SEED_DIR="./database/seed"
# Signs JWTs. Required, and at least 32 characters: an empty or short secret
# is what made every token forgeable with no symptom at all (#36). The server
# now refuses to start rather than accepting one.
JWT_SECRET=<openssl rand -base64 32>
CORS_ALLOWED_ORIGINS=http://localhost:5173
RENDERER_URL=http://localhost:8000

# Whether POST /api/v1/auth/signup accepts new accounts. Defaults to true when
# ENVIRONMENT=development and false everywhere else, because an open signup on
# a reachable instance lets anyone create an account and spend the key above.
# Set it explicitly to run an instance that accepts new accounts.
SIGNUP_ENABLED=true
