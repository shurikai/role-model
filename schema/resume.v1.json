{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shurikai/role-model/schema/resume.v1.json",
  "title": "Resume",
  "description": "Intermediate resume document produced by the generation pipeline, consumed by renderers.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "application_id",
    "resume_version_id",
    "identity",
    "summary",
    "experience",
    "skills",
    "education",
    "credentials",
    "projects",
    "meta"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version for forward compatibility."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "application_id": {
      "type": "string"
    },
    "resume_version_id": {
      "type": "string"
    },
    "identity": {
      "type": "object",
      "required": ["name", "email"],
      "additionalProperties": false,
      "properties": {
        "name":         { "type": "string" },
        "email":        { "type": "string" },
        "phone":        { "type": ["string", "null"] },
        "location":     { "type": ["string", "null"] },
        "linkedin_url": { "type": ["string", "null"] },
        "github_url":   { "type": ["string", "null"] },
        "site_url":     { "type": ["string", "null"] },
        "headline":     { "type": ["string", "null"] }
      }
    },
    "summary": {
      "type": "string",
      "description": "Targeted prose summary generated per application."
    },
    "experience": {
      "type": "array",
      "items": { "$ref": "#/$defs/employer_block" }
    },
    "skills": {
      "type": "object",
      "description": "Keys are user-defined tag categories. Values are ordered lists of tag names.",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "education": {
      "type": "array",
      "items": { "$ref": "#/$defs/education_entry" }
    },
    "credentials": {
      "type": "array",
      "items": { "$ref": "#/$defs/credential_entry" }
    },
    "projects": {
      "type": "array",
      "items": { "$ref": "#/$defs/project_entry" }
    },
    "meta": {
      "$ref": "#/$defs/meta_block"
    }
  },
  "$defs": {
    "bullet": {
      "type": "object",
      "required": ["text", "contribution_ids"],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "contribution_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "feedback_signal": {
          "type": ["string", "null"],
          "enum": ["accepted", "rejected", "edited", null]
        }
      }
    },
    "position_block": {
      "type": "object",
      "required": ["position_id", "title", "started_on", "bullets"],
      "additionalProperties": false,
      "properties": {
        "position_id": { "type": "string" },
        "title":       { "type": "string" },
        "industry_level": {
          "type": ["string", "null"],
          "enum": [
            "junior", "mid", "senior", "staff", "principal",
            "lead", "manager", "director", "vp", "ic", null
          ]
        },
        "started_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "ended_on":   { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}$" },
        "bullets": {
          "type": "array",
          "items": { "$ref": "#/$defs/bullet" }
        }
      }
    },
    "employer_block": {
      "type": "object",
      "required": ["employer", "positions"],
      "additionalProperties": false,
      "properties": {
        "employer": { "type": "string" },
        "positions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/position_block" }
        }
      }
    },
    "education_entry": {
      "type": "object",
      "required": ["institution"],
      "additionalProperties": false,
      "properties": {
        "institution":    { "type": "string" },
        "degree":         { "type": ["string", "null"] },
        "field_of_study": { "type": ["string", "null"] },
        "graduated":      { "type": ["string", "null"] }
      }
    },
    "credential_entry": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name":       { "type": "string" },
        "issuer":     { "type": ["string", "null"] },
        "issued_on":  { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}$" },
        "expires_on": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}$" }
      }
    },
    "project_entry": {
      "type": "object",
      "required": ["project_id", "name", "role", "status", "bullets"],
      "additionalProperties": false,
      "properties": {
        "project_id": { "type": "string" },
        "name":       { "type": "string" },
        "tagline":    { "type": ["string", "null"] },
        "role": {
          "type": "string",
          "enum": ["author", "maintainer", "contributor", "lead"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "dormant", "archived"]
        },
        "started_on":  { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}$" },
        "ended_on":    { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}$" },
        "repo_url":    { "type": ["string", "null"] },
        "live_url":    { "type": ["string", "null"] },
        "writeup_url": { "type": ["string", "null"] },
        "force_include": { "type": "boolean" },
        "force_exclude": { "type": "boolean" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "bullets": {
          "type": "array",
          "items": { "$ref": "#/$defs/bullet" }
        }
      }
    },
    "jd_signals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "priority_skills": {
          "type": "array",
          "items": { "type": "string" }
        },
        "seniority": { "type": ["string", "null"] },
        "domain_vocabulary": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "meta_block": {
      "type": "object",
      "required": ["generation_model", "prompt_version"],
      "additionalProperties": false,
      "properties": {
        "schema_version":   { "type": "string" },
        "generated_at":     { "type": "string" },
        "application_id":   { "type": "string" },
        "target_role":      { "type": ["string", "null"] },
        "target_company":   { "type": ["string", "null"] },
        "jd_signals":       { "$ref": "#/$defs/jd_signals" },
        "generation_model": { "type": "string" },
        "prompt_version":   { "type": "string" }
      }
    }
  }
}
