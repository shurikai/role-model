{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shurikai/role-model/schema/resume.v2.json",
  "title": "Resume",
  "description": "Intermediate resume document produced by the generation pipeline, consumed by renderers.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "application_id",
    "resume_version_id",
    "identity",
    "summary",
    "experience",
    "skills",
    "education",
    "credentials",
    "projects",
    "meta"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version for forward compatibility."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "application_id": {
      "type": "string"
    },
    "resume_version_id": {
      "type": "string"
    },
    "identity": {
      "type": "object",
      "required": [
        "name",
        "email"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "linkedin_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "github_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "site_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "headline": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "summary": {
      "type": "string",
      "description": "Targeted prose summary generated per application."
    },
    "experience": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/employer_block"
      }
    },
    "skills": {
      "type": "object",
      "description": "Keys are user-defined tag categories. Values are ordered lists of tag names.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/education_entry"
      }
    },
    "credentials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/credential_entry"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project_entry"
      }
    },
    "meta": {
      "$ref": "#/$defs/meta_block"
    }
  },
  "$defs": {
    "bullet": {
      "type": "object",
      "required": [
        "text",
        "contribution_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "contribution_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "feedback_signal": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "accepted",
            "rejected",
            "edited",
            null
          ]
        }
      }
    },
    "position_block": {
      "type": "object",
      "required": [
        "position_id",
        "title",
        "started_on",
        "bullets"
      ],
      "additionalProperties": false,
      "properties": {
        "position_id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "description": "The verbatim title the employer used, e.g. \"Programmer VII\". Carried for provenance; the renderer displays industry_role in preference to it."
        },
        "industry_role": {
          "type": [
            "string",
            "null"
          ],
          "description": "The industry-normalized role name, e.g. \"Senior Software Engineer\". Free text, not an enum \u2014 real roles are compound (\"Senior Software Engineer / Architect\"). This is what the renderer displays; title is the fallback when it is absent."
        },
        "industry_level": {
          "type": [
            "string",
            "null"
          ],
          "description": "The rung of the candidate's own career ladder this position sat on, e.g. \"senior\", \"sous\", \"attending\". Free text: the ladder is user-owned vocabulary (career_levels), so an enum here would have been one industry's rungs imposed on every other. It was that enum, and the copy in the renderer's models disagreed with the copy in the extraction prompt about which values could ever appear."
        },
        "started_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "ended_on": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "bullets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bullet"
          }
        }
      }
    },
    "employer_block": {
      "type": "object",
      "required": [
        "employer",
        "positions"
      ],
      "additionalProperties": false,
      "properties": {
        "employer": {
          "type": "string"
        },
        "positions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/position_block"
          }
        }
      }
    },
    "education_entry": {
      "type": "object",
      "required": [
        "institution"
      ],
      "additionalProperties": false,
      "properties": {
        "institution": {
          "type": "string"
        },
        "degree": {
          "type": [
            "string",
            "null"
          ]
        },
        "field_of_study": {
          "type": [
            "string",
            "null"
          ]
        },
        "graduated": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "credential_entry": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "issuer": {
          "type": [
            "string",
            "null"
          ]
        },
        "issued_on": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "expires_on": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}$"
        }
      }
    },
    "project_entry": {
      "type": "object",
      "required": [
        "project_id",
        "name",
        "role",
        "status",
        "bullets"
      ],
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "tagline": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": "string",
          "description": "The person's role on the project, e.g. \"author\", \"lead\", \"principal investigator\", \"head chef\". Free text: v1 enumerated open-source repository roles, which a portfolio of buildings, cases, or performances has none of. Nothing branches on the value; the renderer prints it."
        },
        "status": {
          "type": "string",
          "description": "The project's current state, e.g. \"active\", \"archived\", \"in production\", \"published\". Free text, for the same reason as role."
        },
        "started_on": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "ended_on": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "Where the work itself can be found \u2014 a repository, a catalogue entry, a case number, a recording. Named repo_url in v1."
        },
        "live_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "writeup_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "force_include": {
          "type": "boolean"
        },
        "force_exclude": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bullets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bullet"
          }
        }
      }
    },
    "jd_signals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preferred_skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "seniority": {
          "type": [
            "string",
            "null"
          ]
        },
        "industry": {
          "type": [
            "string",
            "null"
          ],
          "description": "The posting's own words for its industry, e.g. \"freight logistics visibility platform\". Free text. Replaces v1's `domain`, a fixed enum whose values (\"saas\", \"platform\", \"observability\") were product categories rather than industries and collapsed four unrelated postings into one."
        },
        "work_arrangement": {
          "type": [
            "string",
            "null"
          ],
          "description": "How the posting describes where and when the work happens, e.g. \"fully remote with occasional office visits\". Free text. Replaces v1's `work_type`, a remote|hybrid|onsite|unknown enum that recorded a quarter of what the posting said."
        },
        "culture_signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "meta_block": {
      "type": "object",
      "required": [
        "generation_model",
        "prompt_version"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "application_id": {
          "type": "string"
        },
        "target_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_company": {
          "type": [
            "string",
            "null"
          ]
        },
        "jd_signals": {
          "$ref": "#/$defs/jd_signals"
        },
        "generation_model": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        }
      }
    }
  }
}
