# Keep the build context small and, more importantly, keep secrets and
# personal data out of it. Anything listed here cannot end up in an image
# layer even by accident.

.git
.github

# Secrets. .env is gitignored but exists in a working tree, and a build
# context is not a git operation — without this line it would be copied in.
.env
frontend/.env
*.env.local

# The private career seed repo, checked out in place. Never in an image.
database/seed

backups
out.docx

# Build output and caches, all of which are recreated inside the image.
bin
frontend/node_modules
frontend/dist
docx-renderer/.venv
docx-renderer/**/__pycache__
**/*.test

# Editor and OS noise
.idea
.vscode
.DS_Store

# Local agent scratch
.claude
notes
